# copy to .env and fill in
DOMAIN=survey.yourcompany.com
DB_PASSWORD=change-me-long-random
SECRET_KEY=change-me-at-least-32-random-characters
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong
# turn on later: deletes forms+photos older than RETENTION_DAYS from THIS server (keep your replica/backup!)
PURGE_ENABLED=false
RETENTION_DAYS=183
# daily permission: admin gives permission each day; a user who does not open the app within
# PERMISSION_OPEN_HOURS is locked until the admin gives permission again (admins are never limited)
PERMISSION_REQUIRED=true
PERMISSION_OPEN_HOURS=2
TIMEZONE=Asia/Karachi
